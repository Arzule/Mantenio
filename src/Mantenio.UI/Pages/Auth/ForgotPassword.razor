@page "/forgot-password"
@layout AuthLayout
@inherits BusyComponentBase
@inject PublicApi Api

<PageTitle>@UiStrings.ForgotTitle · @CondoProfile.Current.ShortName</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1">@UiStrings.ForgotTitle</MudText>

@if (_done)
{
    <MudAlert Severity="Severity.Success" Class="mt-4">@UiStrings.ResetDone</MudAlert>
    <MudButton Href="login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4">@UiStrings.LoginTitle</MudButton>
}
else if (!_codeSent)
{
    <MudText Class="mt-2">@UiStrings.ForgotBody</MudText>
    <EditForm Model="_emailForm" OnValidSubmit="SendCodeAsync" class="mt-2">
        <DataAnnotationsValidator />
        <MudTextField @bind-Value="_emailForm.Email" For="@(() => _emailForm.Email)" Label="@UiStrings.Email"
                      InputType="InputType.Email" Variant="Variant.Outlined" Class="mt-3"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "email" })" />

        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@Error</MudAlert>
        }

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4" Disabled="Busy">
            @UiStrings.SendCode
        </MudButton>
    </EditForm>
    <MudButton Href="login" Variant="Variant.Text" FullWidth="true" Class="mt-2">@UiStrings.Back</MudButton>
}
else
{
    <MudText Class="mt-2">@UiStrings.ResetBody</MudText>
    <MudText Typo="Typo.body2" Class="mt-1 text-secondary">@UiStrings.CheckSpam</MudText>
    <EditForm Model="_resetForm" OnValidSubmit="ResetAsync" class="mt-2">
        <DataAnnotationsValidator />
        <MudTextField @bind-Value="_resetForm.Code" For="@(() => _resetForm.Code)" Label="@UiStrings.CodeLabel"
                      InputMode="InputMode.numeric" MaxLength="6" Variant="Variant.Outlined" Class="mt-3"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "one-time-code" })" />
        <MudTextField @bind-Value="_resetForm.NewPassword" For="@(() => _resetForm.NewPassword)" Label="@UiStrings.NewPassword"
                      HelperText="@UiStrings.PasswordHint" InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-3"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })" />
        <MudTextField @bind-Value="_resetForm.ConfirmPassword" For="@(() => _resetForm.ConfirmPassword)" Label="@UiStrings.ConfirmPassword"
                      InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-3"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })" />

        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@Error</MudAlert>
        }

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4" Disabled="Busy">
            @UiStrings.ResetSubmit
        </MudButton>
    </EditForm>
    <MudButton Variant="Variant.Text" FullWidth="true" Class="mt-2" OnClick="SendCodeAsync" Disabled="Busy">@UiStrings.ResendCode</MudButton>
}

@code {
    private readonly ForgotPasswordForm _emailForm = new();
    private readonly ResetPasswordForm _resetForm = new();
    private bool _codeSent;
    private bool _done;

    private Task SendCodeAsync() => RunAsync(async () =>
    {
        await Api.ForgotPasswordAsync(_emailForm.Email.Trim());
        _codeSent = true;
    });

    private Task ResetAsync() => RunAsync(async () =>
    {
        await Api.ResetPasswordAsync(new ResetPasswordRequest(_emailForm.Email.Trim(), _resetForm.Code, _resetForm.NewPassword));
        _done = true;
    });
}
