@page "/account/password"
@attribute [Authorize]
@inherits BusyComponentBase
@inject MantenioApi Api
@inject AuthSession Session
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@UiStrings.ChangePasswordTitle · @CondoProfile.Current.ShortName</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-6">
    <MudPaper Class="pa-6" Elevation="1">
        <MudText Typo="Typo.h5" HtmlTag="h1">@UiStrings.ChangePasswordTitle</MudText>

        <AuthorizeView Context="auth">
            @if (auth.User.HasClaim(MantenioClaims.MustChangePassword, "true"))
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">@UiStrings.MustChangePasswordBody</MudAlert>
            }
        </AuthorizeView>

        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_form.CurrentPassword" For="@(() => _form.CurrentPassword)" Label="@UiStrings.CurrentPassword"
                          InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-3"
                          UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "current-password" })" />
            <MudTextField @bind-Value="_form.NewPassword" For="@(() => _form.NewPassword)" Label="@UiStrings.NewPassword"
                          HelperText="@UiStrings.PasswordHint" InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-3"
                          UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })" />
            <MudTextField @bind-Value="_form.ConfirmPassword" For="@(() => _form.ConfirmPassword)" Label="@UiStrings.ConfirmPassword"
                          InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-3"
                          UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })" />

            @if (Error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@Error</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Disabled="Busy">
                @UiStrings.ResetSubmit
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private readonly ChangePasswordForm _form = new();

    private async Task SaveAsync()
    {
        var saved = await RunAsync(async () =>
        {
            var tokens = await Api.ChangePasswordAsync(new ChangePasswordRequest(_form.CurrentPassword, _form.NewPassword, Session.KeepSignedIn));
            await Session.SignInAsync(tokens, Session.KeepSignedIn);
        });

        if (saved)
        {
            Snackbar.Add(UiStrings.PasswordChanged, Severity.Success);
            Navigation.NavigateTo("", replace: true);
        }
    }
}
