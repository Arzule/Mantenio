@page "/payments"
@page "/apartments/{ApartmentId:guid}/statement"
@attribute [Authorize]
@inherits BusyComponentBase
@inject MantenioApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@UiStrings.NavPayments · @CondoProfile.Current.ShortName</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
        <MudText Typo="Typo.h5" HtmlTag="h1">
            @(ApartmentId is null ? UiStrings.PaymentsTitle : Formats.Format(UiStrings.StatementOf, _statement?.ApartmentCode ?? ""))
        </MudText>
        @if (ApartmentId is null && _apartmentId is not null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload" OnClick="UploadAsync">@UiStrings.UploadProof</MudButton>
        }
    </div>

    @if (ApartmentId is null && _apartmentId is null && _loaded)
    {
        <MudAlert Severity="Severity.Info">@UiStrings.PaymentsNoApartment</MudAlert>
    }
    else if (_statement is null)
    {
        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error">@Error</MudAlert>
        }
        else
        {
            <LoadingIndicator />
        }
    }
    else
    {
        <MudGrid Spacing="2" Class="mb-3">
            @Summary(UiStrings.TotalOutstanding, _statement.TotalOutstanding, Color.Primary)
            @Summary(UiStrings.OverdueDebt, _statement.OverdueDebt, _statement.OverdueDebt > 0 ? Color.Error : Color.Default)
            @Summary(UiStrings.Credit, _statement.Credit, _statement.Credit > 0 ? Color.Success : Color.Default)
        </MudGrid>
        @if (_statement.IsFrozen)
        {
            <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.AcUnit" Class="mb-3">@UiStrings.ApartmentFrozen</MudAlert>
        }
        @if (ApartmentId is null)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountBalance" Href="bank-accounts" Class="mb-2">
                @UiStrings.SeeBankAccounts
            </MudButton>
        }

        <MudTabs Elevation="0" ApplyEffectsToContainer="true" TabPanelsClass="pt-3" @bind-ActivePanelIndex="_tab">
            <MudTabPanel Text="@UiStrings.TabStatement">
                @if (_statement.Charges.Count == 0)
                {
                    <MudText>@UiStrings.NoCharges</MudText>
                }
                @foreach (var charge in _statement.Charges)
                {
                    <MudPaper Class="pa-3 mb-2 d-flex align-center justify-space-between gap-2" Elevation="1">
                        <div style="min-width: 0">
                            <MudText Typo="Typo.subtitle1"><b>@Formats.Month(charge.Period)</b> · @LedgerText.ChargeType(charge.Type)</MudText>
                            <MudText Typo="Typo.body2">
                                @(charge.Status == DebtStatus.PartiallyPaid ? Formats.Format(UiStrings.PaidOf, Formats.Money(charge.Paid), Formats.Money(charge.Amount)) : Formats.Money(charge.Amount))
                                · @Formats.Format(UiStrings.DueOn, Formats.Date(charge.DueDate))
                            </MudText>
                        </div>
                        <div class="d-flex align-center gap-1">
                            <MudChip T="string" Size="Size.Small" Color="@LedgerText.DebtColor(charge)">
                                @(charge.Overdue ? UiStrings.Overdue : LedgerText.Debt(charge.Status))
                            </MudChip>
                            @if (_isAdmin)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small" aria-label="@UiStrings.ChargeHistory"
                                               OnClick="() => TimelineAsync(charge)" />
                            }
                        </div>
                    </MudPaper>
                }
            </MudTabPanel>
            <MudTabPanel Text="@UiStrings.TabProofs" BadgeData="@(PendingCount > 0 ? PendingCount : null)" BadgeColor="Color.Warning">
                @if (_statement.Payments.Count == 0)
                {
                    <MudText>@UiStrings.NoProofs</MudText>
                }
                <MudStack Spacing="2">
                    @foreach (var proof in _statement.Payments)
                    {
                        <ProofCard Item="proof" />
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    private AccountStatement? _statement;
    private Guid? _apartmentId;
    private bool _isAdmin;
    private bool _loaded;
    private int _tab;

    [Parameter]
    public Guid? ApartmentId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private int PendingCount => _statement?.Payments.Count(p => p.Status == ProofStatus.Pending) ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthState).User;
        _isAdmin = user.HasClaim(MantenioClaims.Role, nameof(AccountRole.Admin));
        _apartmentId = ApartmentId ?? (Guid.TryParse(user.FindFirst(MantenioClaims.ApartmentId)?.Value, out var id) ? id : null);
        _loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_apartmentId is { } id)
        {
            await RunAsync(async () => _statement = await Api.GetStatementAsync(id));
        }
    }

    private async Task UploadAsync()
    {
        var dialog = await Dialogs.ShowAsync<UploadProofDialog>(UiStrings.UploadProofTitle,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add(UiStrings.ProofSent, Severity.Success);
            _tab = 1;
            await LoadAsync();
        }
    }

    private async Task TimelineAsync(ChargeItem charge)
    {
        var parameters = new DialogParameters<ChargeTimelineDialog>
        {
            { d => d.ChargeId, charge.Id },
            { d => d.Title, $"{Formats.Month(charge.Period)} · {LedgerText.ChargeType(charge.Type)}" },
        };
        await Dialogs.ShowAsync<ChargeTimelineDialog>(UiStrings.ChargeHistory, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
    }

    private static RenderFragment Summary(string label, decimal amount, Color color) => __builder =>
    {
        <MudItem xs="4">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption">@label</MudText>
                <MudText Typo="Typo.h6" Color="color">@Formats.Money(amount)</MudText>
            </MudPaper>
        </MudItem>
    };
}
