@page "/"
@attribute [Authorize]

<PageTitle>@UiStrings.NavHome · @Profile.ShortName</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <MudPaper Class="pa-6" Elevation="1">
        <div class="home-hero">
            <img class="home-logo" src="@CondoProfile.LogoDataUri" alt="@string.Format(UiStrings.LogoAlt, Profile.DisplayName)" />
            <div class="home-text">
                <AuthorizeView>
                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                        @string.Format(UiStrings.HomeGreeting, context.User.FindFirst(MantenioClaims.FirstName)?.Value)
                    </MudText>
                </AuthorizeView>
                <MudText Typo="Typo.h4" HtmlTag="h1" Color="Color.Primary" Class="home-title">
                    @string.Format(UiStrings.HomeWelcomeTitle, Profile.DisplayName)
                </MudText>
                <MudText Class="mt-2">@UiStrings.HomeWelcomeBody</MudText>
                @if (!string.IsNullOrWhiteSpace(Profile.Address))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                        <b>@UiStrings.HomeAddressLabel:</b> @Profile.Address
                    </MudText>
                }
            </div>
        </div>
    </MudPaper>
    <AuthorizeView Policy="@MantenioPolicies.StaffOnly">
        <Authorized>
            @if (context.User.HasClaim(MantenioClaims.Role, nameof(AccountRole.Guard)))
            {
                @* The gatehouse has no apartment: its home is the shortcut to its two tasks. *@
                <MudPaper Class="pa-6 mt-4" Elevation="1">
                    <MudText Typo="Typo.h6" HtmlTag="h2">@UiStrings.GuardHomeTitle</MudText>
                    <MudText Class="mt-2">@UiStrings.GuardHomeBody</MudText>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <MudButton Href="admin/payments" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FactCheck">@UiStrings.NavPaymentReview</MudButton>
                        <MudButton Href="admin/invitations" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd">@UiStrings.NavInvitations</MudButton>
                    </div>
                </MudPaper>
            }
            else
            {
                <MyFeeCard />
            }
        </Authorized>
        <NotAuthorized>
            <MyFeeCard />
        </NotAuthorized>
    </AuthorizeView>
</MudContainer>

@code {
    private static readonly CondoProfile Profile = CondoProfile.Current;
}
