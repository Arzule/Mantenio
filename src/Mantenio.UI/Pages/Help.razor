@page "/help"
@attribute [Authorize]

<PageTitle>@UiStrings.HelpTitle · @CondoProfile.Current.ShortName</PageTitle>

@* Short manual: resident topics for everyone, admin topics only for admins. Texts in UiStrings.resx (Help*). *@
<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <MudText Typo="Typo.h5" HtmlTag="h1">@UiStrings.HelpTitle</MudText>
    <MudText Class="mt-2 mb-4">@UiStrings.HelpIntro</MudText>

    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@UiStrings.HelpResidents</MudText>
    @Topics(ResidentTopics)

    <AuthorizeView Policy="@MantenioPolicies.AdminOnly">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-6 mb-2">@UiStrings.HelpAdmins</MudText>
        @Topics(AdminTopics)
    </AuthorizeView>
</MudContainer>

@code {
    private static readonly (string Title, string Body, bool IsNew)[] ResidentTopics =
    [
        (UiStrings.HelpOnePaymentTitle, UiStrings.HelpOnePaymentBody, true),
        (UiStrings.HelpRegisterTitle, UiStrings.HelpRegisterBody, false),
        (UiStrings.HelpPayTitle, UiStrings.HelpPayBody, false),
        (UiStrings.HelpStatementTitle, UiStrings.HelpStatementBody, false),
        (UiStrings.HelpNoticesTitle, UiStrings.HelpNoticesBody, false),
        (UiStrings.HelpRejectedTitle, UiStrings.HelpRejectedBody, false),
    ];

    private static readonly (string Title, string Body, bool IsNew)[] AdminTopics =
    [
        (UiStrings.HelpHistoricalTitle, UiStrings.HelpHistoricalBody, true),
        (UiStrings.HelpReviewTitle, UiStrings.HelpReviewBody, false),
        (UiStrings.HelpWalkInTitle, UiStrings.HelpWalkInBody, false),
        (UiStrings.HelpVoidTitle, UiStrings.HelpVoidBody, false),
        (UiStrings.HelpReportsTitle, UiStrings.HelpReportsBody, false),
        (UiStrings.HelpSettingsTitle, UiStrings.HelpSettingsBody, false),
        (UiStrings.HelpSecurityTitle, UiStrings.HelpSecurityBody, false),
    ];

    private static RenderFragment Topics((string Title, string Body, bool IsNew)[] topics) => __builder =>
    {
        <MudExpansionPanels MultiExpansion="true" Elevation="1">
            @foreach (var (title, body, isNew) in topics)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <div class="d-flex align-center gap-2">
                            @if (isNew)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@UiStrings.New</MudChip>
                            }
                            <MudText>@title</MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                    <MudText Typo="Typo.body2" Style="white-space: pre-line">@body</MudText>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    };
}
