@inherits LayoutComponentBase
@implements IDisposable
@inject AuthSession Session
@inject NavigationManager Navigation
@inject MantenioApi Api
@inject IPushRegistration Push

<ThemeProviders />
<PendingNoticesGate OnAcknowledged="RefreshUnreadAsync" />

@* Plain root element so the scoped ::deep rules in MainLayout.razor.css reach MudMainContent. *@
<div class="layout-root">
<MudLayout>
    <MudAppBar Elevation="1">
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           aria-label="@UiStrings.ToggleMenu"
                           OnClick="ToggleDrawer" />
        </MudHidden>
        <img class="appbar-logo" src="@CondoProfile.LogoDataUri" alt="@string.Format(UiStrings.LogoAlt, Profile.DisplayName)" />
        <MudText Typo="Typo.h6" Class="ml-3 appbar-title">@Profile.ShortName</MudText>
        <MudSpacer />
        <AuthorizeView>
            <MudIconButton Href="notifications" Color="Color.Inherit" aria-label="@UiStrings.NavNotifications">
                <MudBadge Content="_unread" Visible="_unread > 0" Color="Color.Secondary" Overlap="true">
                    <MudIcon Icon="@Icons.Material.Filled.Notifications" />
                </MudBadge>
            </MudIconButton>
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                     Color="Color.Inherit"
                     AriaLabel="@UiStrings.AccountMenu"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight">
                <div class="px-4 py-2">
                    <MudText Typo="Typo.subtitle2">@context.User.Identity?.Name</MudText>
                    <MudText Typo="Typo.caption">@RoleLabel(context.User)</MudText>
                </div>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.HelpOutline" Href="help">@UiStrings.NavHelp</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Key" Href="account/password">@UiStrings.ChangePasswordMenu</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync">@UiStrings.SignOut</MudMenuItem>
            </MudMenu>
        </AuthorizeView>
    </MudAppBar>

    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
            <MudNavMenu Class="pt-2">
                @foreach (var item in _items.Where(i => i.InDrawer))
                {
                    <MudNavLink Href="@item.Href" Match="item.Match" Icon="@item.Icon">@item.Title</MudNavLink>
                }
            </MudNavMenu>
        </MudDrawer>
    </MudHidden>

    <MudMainContent Class="main-content">
        @Body
    </MudMainContent>

    @if (_items.Count(i => i.InBottomBar) > 1)
    {
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <nav class="bottom-nav mud-elevation-4" aria-label="@UiStrings.AppName">
                @foreach (var item in _items.Where(i => i.InBottomBar))
                {
                    <NavLink class="bottom-nav-item" href="@item.Href" Match="item.Match">
                        <MudIcon Icon="@item.Icon" />
                        <span>@item.Title</span>
                    </NavLink>
                }
            </nav>
        </MudHidden>
    }
</MudLayout>
</div>

@code {
    private static readonly CondoProfile Profile = CondoProfile.Current;
    private bool _drawerOpen = true;
    private List<NavigationItem> _items = [.. NavigationItems.All.Where(i => i.Audience is NavAudience.Everyone or NavAudience.ApartmentHolders)];
    private int _unread;
    private DateTimeOffset _unreadCheckedAt;
    private bool _pushRegistered;
    private readonly CancellationTokenSource _disposed = new();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is null)
        {
            return;
        }

        var user = (await AuthenticationState).User;
        _items = [.. NavigationItems.For(user)];
        if (user.Identity?.IsAuthenticated == true && DateTimeOffset.UtcNow - _unreadCheckedAt > TimeSpan.FromSeconds(30))
        {
            await RefreshUnreadAsync();
        }

        // Once per app start: this phone receives the push copy of the notices (no-op on the web).
        if (user.Identity?.IsAuthenticated == true && !_pushRegistered && !user.HasClaim(MantenioClaims.MustChangePassword, "true"))
        {
            _pushRegistered = true;
            await Push.RegisterAsync();
        }

        // A temporary password blocks everything else until it is replaced.
        if (user.HasClaim(MantenioClaims.MustChangePassword, "true")
            && !Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("account/password", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("account/password", replace: true);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _ = CheckPeriodicallyAsync(_disposed.Token);
        }
    }

    /// <summary>
    /// Every minute, even without navigating: refreshes the bell badge and, through that call, notices a session
    /// revoked elsewhere (e.g. a password change on another phone), which signs this app out.
    /// </summary>
    private async Task CheckPeriodicallyAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (Session.User.Identity?.IsAuthenticated == true)
                {
                    await InvokeAsync(async () =>
                    {
                        await RefreshUnreadAsync();
                        StateHasChanged();
                    });
                }
            }
        }
        catch (OperationCanceledException)
        {
            // The layout went away.
        }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    /// <summary>Unread notices for the bell badge; checked at most every 30 s while navigating.</summary>
    private async Task RefreshUnreadAsync()
    {
        _unreadCheckedAt = DateTimeOffset.UtcNow;
        try
        {
            _unread = (await Api.ListNotificationsAsync()).UnreadCount;
        }
        catch (ApiException)
        {
            // Offline or signed out: keep the last value.
        }
    }

    private async Task SignOutAsync()
    {
        await Push.UnregisterAsync();
        _pushRegistered = false;
        await Session.SignOutAsync();
        Navigation.NavigateTo("login", replace: true);
    }

    private static string RoleLabel(System.Security.Claims.ClaimsPrincipal user) =>
        RoleLabels.For(
            Enum.TryParse<AccountRole>(user.FindFirst(MantenioClaims.Role)?.Value, out var role) ? role : AccountRole.Resident,
            user.HasClaim(MantenioClaims.Founder, "true"));
}
