@using Mantenio.Shared.Reports
@inherits BusyComponentBase
@inject MantenioApi Api

@* Admin home: proofs to review, overdue debt (total and by tower) and this month's collection. *@
@if (_dashboard is { } d)
{
    <MudGrid Spacing="2" Class="mb-4">
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="1" Style="cursor: pointer" @onclick="@(() => Navigation.NavigateTo("admin/payments"))">
                <MudText Typo="Typo.caption">@UiStrings.DashboardPending</MudText>
                <MudText Typo="Typo.h5" Color="@(d.PendingProofs > 0 ? Color.Warning : Color.Default)">@d.PendingProofs</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption">@Formats.Format(UiStrings.DashboardCollected, Formats.Month(d.CurrentPeriod))</MudText>
                <MudText Typo="Typo.h5" Color="Color.Success">@Formats.Money(d.CollectedThisMonth)</MudText>
                <MudText Typo="Typo.caption">@Formats.Format(UiStrings.DashboardReceipts, d.ReceiptsThisMonth)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="1" Style="cursor: pointer" @onclick="@(() => Navigation.NavigateTo("admin/reports"))">
                <MudText Typo="Typo.caption">@UiStrings.DashboardOverdue</MudText>
                <MudText Typo="Typo.h5" Color="@(d.OverdueDebt > 0 ? Color.Error : Color.Default)">@Formats.Money(d.OverdueDebt)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="1" Style="cursor: pointer" @onclick="@(() => Navigation.NavigateTo("admin/reports"))">
                <MudText Typo="Typo.caption">@UiStrings.DashboardDelinquent</MudText>
                <MudText Typo="Typo.h5">@d.DelinquentApartments</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">@Formats.Format(UiStrings.DashboardByTower, CondoProfile.Current.TowerLabel)</MudText>
        @if (d.Towers.Count == 0)
        {
            <MudText Typo="Typo.body2">@UiStrings.DashboardNoDebt</MudText>
        }
        @foreach (var tower in d.Towers)
        {
            <div class="d-flex align-center gap-3 mb-2">
                <MudText Style="min-width: 2.5rem"><b>@tower.Tower</b></MudText>
                <MudProgressLinear Color="Color.Error" Value="@Percent(tower)" Rounded="true" Size="Size.Medium" Style="flex: 1" />
                <MudText Typo="Typo.caption" Style="min-width: 11rem; text-align: right">
                    @Formats.Format(UiStrings.DashboardTowerLine, tower.DelinquentApartments, tower.Apartments, Formats.Money(tower.Amount))
                </MudText>
            </div>
        }
    </MudPaper>
}
else if (Error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@Error</MudAlert>
}

@code {
    private AdminDashboard? _dashboard;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    protected override Task OnInitializedAsync() => RunAsync(async () => _dashboard = await Api.GetDashboardAsync());

    private static double Percent(TowerDebt tower) =>
        tower.Apartments == 0 ? 0 : 100.0 * tower.DelinquentApartments / tower.Apartments;
}
