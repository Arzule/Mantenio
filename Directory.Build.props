<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Public XML docs are not required; keep CS1591 quiet if docs get enabled later. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Condo profile selection. Every condo has its own folder under condos/<slug>/
    (condo.json + logo + app icons). Build with -p:Condo=<slug> to target another condo.
  -->
  <!-- A condo deployment repo (e.g. a pilot) adds Condo.props at the root to pick its profile. -->
  <Import Project="$(MSBuildThisFileDirectory)Condo.props" Condition="Exists('$(MSBuildThisFileDirectory)Condo.props')" />

  <PropertyGroup>
    <Condo Condition="'$(Condo)' == ''">demo</Condo>
    <CondoDir>$(MSBuildThisFileDirectory)condos\$(Condo)\</CondoDir>
  </PropertyGroup>

  <Target Name="ValidateCondoProfile" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(CondoDir)condo.json')"
           Text="Condo profile '$(Condo)' not found: expected $(CondoDir)condo.json" />
  </Target>

</Project>
